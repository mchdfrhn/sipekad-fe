server {
    listen ${PORT};
    server_name localhost;

    # Railway private network DNS (IPv6). Required so nginx can resolve *.railway.internal.
    resolver [fd12::10] valid=10s ipv6=on;

    # Allow file uploads (PDF/images) to pass through to the backend
    client_max_body_size 50m;

    # Reverse proxy to the backend over Railway's internal network.
    # Browser calls /api/*, nginx strips the prefix and forwards to BACKEND_INTERNAL_URL
    # (e.g. http://sipekad-be.railway.internal:3000).
    location /api/ {
        set $backend "${BACKEND_INTERNAL_URL}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;

        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

        # AI chat streams its response; don't buffer it
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri /index.html;
        # Disable caching for index.html to prevent stale chunk mismatch after deployments
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # Optional: Handle caching for static assets
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
